# ==============================================================================
# Collaborative Notebook - Environment Variables
# ==============================================================================

# Application Port (Next.js Web Server)
PORT=3000

# Collaboration WebSocket Server Port & Public WSS URL
COLLAB_PORT=1234

# ------------------------------------------------------------------------------
# WebSocket Connection URL
# ------------------------------------------------------------------------------
# For local development:
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234
# For production on Render / Fly.io (Split Deployment):
# NEXT_PUBLIC_COLLAB_WS_URL=wss://your-collab-service.onrender.com
# For production behind Caddy/Nginx reverse proxy:
# NEXT_PUBLIC_COLLAB_WS_URL=wss://notebook.yourdomain.com/collab-ws

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing user session JWTs and WebSocket auth tokens
# Generate a secure 32-character random string (e.g. openssl rand -base64 32)
JWT_SECRET=super-secret-notebook-key-dev-38914820

# Google OAuth (Optional: demo accounts work out of the box)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# Optional: Leave empty for local zero-config SQLite in ./data/notebook.db
# For cloud production (Neon / Supabase PostgreSQL):
DATABASE_URL=

# ------------------------------------------------------------------------------
# Transactional Email (Optional - Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# Error Tracking (Optional - Sentry)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
